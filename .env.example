# Security
SECRET_KEY=replace-with-a-random-secret-key-32-chars

# MongoDB Database (Use MongoDB Atlas free tier for cloud deployment)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/aptiforge?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/aptiforge

# AI Hint Service (Optional - system includes built-in fallback hints)
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=
